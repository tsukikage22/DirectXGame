/// @file UI_VS.hlsl
/// @brief UI合成用頂点シェーダー

//---------------------------------------------------------------
// 頂点シェーダーのメイン関数
//---------------------------------------------------------------
float4 main(uint vid : SV_VertexID) : SV_Position {
    // フルスクリーン三角形：uv = (0, 0), (2, 0), (0, 2)
    float2 uv = float2((vid << 1) & 2, vid & 2);
    return float4(uv * float2(2.0f, -2.0f) + float2(-1.0f, 1.0f), 0.0f, 1.0f);
}